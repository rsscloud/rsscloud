{
    "name": "@rsscloud/server",
    "version": "4.0.1",
    "description": "An rssCloud Server",
    "main": "app.js",
    "scripts": {
        "start": "node --use_strict app.js",
        "dev": "nodemon --use_strict --ignore data/ ./app.js",
        "test": "node --test services/*.test.js",
        "lint": "eslint --fix controllers/ services/ *.js"
    },
    "engines": {
        "node": ">=24"
