    "author": "Andrew Shell <andrew@andrewshell.org>",
    "license": "MIT",
    "dependencies": {
        "@rsscloud/core": "workspace:*",
        "@rsscloud/express": "workspace:*",
        "cors": "^2.8.6",
        "dayjs": "^1.11.23",
        "dotenv": "^17.4.2",
        "express": "^4.22.3",
        "express-handlebars": "^9.0.2",
        "markdown-it": "^14.3.3",
        "morgan": "^1.12.1",
        "ws": "^8.22.0",
        "xmlbuilder": "^15.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
